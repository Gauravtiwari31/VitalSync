# ============================================================
# VitalSync Environment Variables
# Copy this file and fill in your actual values before deploying
# ============================================================

# ---- DATABASE (Neon PostgreSQL) ----
# Paste your Neon connection string here (Settings > Connection String > Pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/vitalsync?sslmode=require

# ---- LIVEKIT (Video Rooms) ----
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=https://your-livekit-server.livekit.cloud

# ---- GEMINI AI ----
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# ---- PUSHER (Realtime) ----
NEXT_PUBLIC_PUSHER_APP_ID=your_pusher_app_id
NEXT_PUBLIC_PUSHER_PUBLISHABLE_KEY=your_pusher_publishable_key
PUSHER_SECRET_KEY=your_pusher_secret_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster

# ---- RAZORPAY (Billing) ----
key_id=your_razorpay_key_id
key_secret=your_razorpay_key_secret

# ---- APPLICATION ----
# Set this to your Vercel deployment URL after first deploy
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# ---- GOOGLE OAUTH ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match the URI configured in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-project.vercel.app/api/auth/google/callback

# ---- LIVEKIT OPTIONAL ----
NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=/api/connection-details
NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
NEXT_PUBLIC_LK_RECORD_ENDPOINT=https://your-recording-endpoint

# ---- NEON DIRECT URL (for migrations only, not pooled) ----
# From Neon: Settings > Connection String > Direct (unpooled)
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/vitalsync?sslmode=require
